{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chase",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "LIVE", "service": "chase-live" }],
  "vars": { "LIVE_TRANSPORT": "http" },
  "routes": [{ "pattern": "chase.sundaysuite.app", "custom_domain": true }],
  "observability": {
    "enabled": true
  }
  // Runtime env (NEXT_PUBLIC_* are build-time inlined):
  //   SUPABASE_SERVICE_ROLE_KEY is a runtime Worker secret:
  //     npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
}
