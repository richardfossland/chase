{
  "name": "chase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p live/tsconfig.json",
    "live:dev": "wrangler dev -c live/wrangler.jsonc --port 8787",
    "live:types": "wrangler types -c live/wrangler.jsonc live/worker-configuration.d.ts",
