    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
